HOST=127.0.0.1
PORT=4173
# Optional. Keys may instead be entered for the current browser session.
ROAM_TEXT_KEY=
ROAM_IMAGE_KEY=
# Required together when HOST is not a loopback address.
ROAM_ACCESS_TOKEN=
ROAM_ALLOWED_API_HOSTS=
# Set to 1 only when deliberately connecting a model on your own local network.
ROAM_ALLOW_LOCAL_API=0

# Optional OpenRouter profile. Keep secrets on the local server.
OPENROUTER_API_KEY=
ROAM_TEXT_BASE_URL=https://openrouter.ai/api/v1
ROAM_TEXT_MODEL=openai/gpt-5.6-luna
ROAM_IMAGE_BASE_URL=https://openrouter.ai/api/v1
ROAM_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
ROAM_PROVIDER_CONFIG_VERSION=openrouter-luna-sunburst-v1
