  "required": [
    "version",
    "id",
    "name",
    "character",
    "baseOutfitId",
    "assets",
    "outfits",
    "furniture",
    "items",
    "scenes"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "asset": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "maxLength": 239
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 16384
        }
      },
      "required": [
        "src",
        "width",
        "height"
      ]
    },
    "frame": {
      "type": "object",
      "properties": {
        "asset": {
          "$ref": "#/$defs/id"
        },
        "rect": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 16384
          },
          "minItems": 4,
          "maxItems": 4
        },
        "duration": {
          "type": "number",
          "minimum": 100,
          "maximum": 60000
        },
        "registration": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": -1,
              "maximum": 2
            },
            "y": {
              "type": "number",
              "minimum": -1,
              "maximum": 2
            },
            "width": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 3
            },
            "height": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 3
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ]
        }
      },
      "required": [
        "asset"
      ]
    },
    "clip": {
      "type": "object",
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "frames"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/clip"
          }
        }
      },
      "required": [
        "name",
        "variants"
      ]
    },
    "furniture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string"
        },
        "empty": {
          "$ref": "#/$defs/frame"
        },
        "canvas": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "number",
              "minimum": 1,
              "maximum": 16384
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "pivot": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "defaultWidth": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 1
        },
        "shadow": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height",
            "opacity"
          ]
        },
        "actions": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/action"
          }
        },
        "price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999
        }
      },
      "required": [
        "id",
        "name",
        "empty",
        "canvas",
        "pivot",
        "defaultWidth",
        "actions"
      ]
    },
    "placement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "furnitureId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 1
        },
        "z": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "flip": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "furnitureId",
        "x",
        "y",
        "width"
      ]
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string"
        },
        "background": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 16384
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999
        }
      },
      "required": [
        "id",
        "name",
        "background",
        "width",
        "height",
        "placements"
      ]
    },
    "outfit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string"
        },
        "preview": {
          "$ref": "#/$defs/frame"
        },
        "price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999
        }
      },
      "required": [
        "id",
        "name",
        "preview"
      ]
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "sprite": {
          "$ref": "#/$defs/frame"
        },
        "price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999
        }
      },
      "required": [
        "id",
        "name",
        "sprite"
      ],
      "not": {
        "required": [
          "slot"
        ]
      }
    }
  }
}
