{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roam Atelier furniture interactions v2",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "revision": {
      "type": "string"
    },
    "character": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "baseOutfitId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 512,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "outfits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outfit"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "furniture": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/furniture"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "postcards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
          },
          "title": {
            "type": "string"
          },
          "sprite": {
            "$ref": "#/$defs/frame"
          }
        },
        "required": [
          "id",
          "sprite"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "defaults": {
      "type": "object",
      "properties": {
        "travelMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 43200
        },
        "frequencyMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 43200
        },
        "activityMinMinutes": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 43200
        },
        "activityMaxMinutes": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 43200
        },
        "wanderBetweenScenes": {
          "type": "boolean"
        },
        "directedTripCost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999
        },
        "coinMailMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200
        },
        "coinMailAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "travelMinMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200
        },
        "travelMaxMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200
        },
        "restMinMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200
        },
        "restMaxMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 43200
        },
        "journeyMinNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "journeyMaxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "photoStyleId": {
          "type": "string",
          "enum": [
            "pack-default",
            "ink-wash",
            "photorealism",
            "classical-oil",
            "impressionism",
            "post-impressionism",
            "watercolor",
            "gouache",
            "ukiyo-e",
            "blue-green-shanshui",
            "graphite",
            "charcoal",
            "etching",
            "pastel",
            "pointillism",
            "fauvism",
            "cubism",
            "art-nouveau",
            "art-deco",
            "paper-cut",
            "pixel-art"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "defaultPhotoAsset": {
      "$ref": "#/$defs/id"
    },
